use crate::mocap;
use crate::mocap::client_message::Payload;
use axum::{
    Router,
    extract::{
        State,
        ws::{Message, WebSocket, WebSocketUpgrade},
    },
    routing::get,
};
use futures::stream::StreamExt;
use prost::Message as ProstMessage;
use std::sync::Arc;
use tokio::sync::watch;

type SharedState = Arc<watch::Sender<Option<mocap::MocapFrame>>>;

pub fn create_router(tx: watch::Sender<Option<mocap::MocapFrame>>) -> Router {
    let state = Arc::new(tx);
    Router::new()
        .route("/ws", get(ws_handler))
        .with_state(state)
}

async fn ws_handler(
    ws: WebSocketUpgrade,
    State(state): State<SharedState>,
) -> axum::response::Response {
    ws.on_upgrade(move |socket| handle_socket(socket, state))
}

async fn handle_socket(mut socket: WebSocket, tx: SharedState) {
    println!("Клиент подключен по WS (TCP)");

    let mut current_skeleton_type = String::new();

    while let Some(Ok(msg)) = socket.next().await {
        match msg {
            Message::Binary(bytes) => match mocap::ClientMessage::decode(bytes) {
                Ok(client_msg) => match client_msg.payload {
                    Some(Payload::Handshake(handshake)) => {
                        current_skeleton_type = handshake.skeleton_type;
                        println!(
                            "Получен handshake, тип скелета: {}",
                            current_skeleton_type.skeleton_type
                        );
                    }
                    Some(Payload::Frame(frame)) => {
                        let _ = tx.send(Some(frame));
                    }
                    None => {
                        eprintln!("Получено пустое сообщение (payload отсутствует)");
                    }
                },
                Err(e) => {
                    eprintln!("Ошибка парсига protobuf: {}", e);
                }
            },
            Message::Close(_) => {
                println!("Клиент отключен");
                break;
            }
            _ => {}
        }
    }
}
